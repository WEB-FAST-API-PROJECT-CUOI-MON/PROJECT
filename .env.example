# Sao chép file này thành ".env" rồi điền giá trị thật. KHÔNG commit file .env.

DATABASE_URL=mysql+pymysql://root:123456@localhost:3306/fastapidb
SECRET_KEY=change-this-secret-key-please-use-a-random-32-byte-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
